{
  "expo": {
    "name": "Next Own",
    "slug": "Next_Own",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nextown",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/expo-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "backgroundImage": "./assets/images/android-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "imosman.next_own",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A66D9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Next_Own to access your photos to update your profile picture."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2da10844-8cca-495c-9b72-688f3d55bf9d"
      }
    }
  }
}
